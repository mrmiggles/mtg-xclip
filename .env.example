# Server-only. Never prefix these with NEXT_PUBLIC_.
CLIPBOARD_PASSWORD=replace-with-a-long-random-password

# Required when hosted (NODE_ENV=production).
# Get these from your Upstash Redis database's REST connection settings.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Expire 24 hours after the last edit. Reads do not extend this time.
CLIPBOARD_TTL_SECONDS=86400

# Use a unique key if multiple deployments share a Redis database.
CLIPBOARD_REDIS_KEY=xclip:clipboard

# Local development fallback when Redis isn't configured:
# CLIPBOARD_DATA_DIR=./data
